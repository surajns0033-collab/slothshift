{
  "name": "slothshift",
  "version": "0.1.0",
  "description": "A local-first AI night worker powered by on-device Gemma via Ollama",
  "main": "electron/main.cjs",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check renderer.js && node --check electron/safety.cjs",
    "dist:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron": "^33.2.1"
  },
  "devDependencies": {
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.slothshift.desktop",
    "productName": "SlothShift",
    "files": [
      "index.html",
      "electron/**/*",
      "tests/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "directories": {
      "output": "release"
    }
  }
}
